# 数据库连接配置示例
# 用法：复制此文件为 .env，然后填入你自己的信息
#   copy .env.example .env
#
# 格式：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql+pymysql://用户名:密码@127.0.0.1:3306/lab_agent

# JWT 配置
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=请替换为你自己随机生成的密钥
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 注意：
# 1. 数据库需要提前创建，并建议使用 utf8mb4 字符集：
#    CREATE DATABASE lab_agent CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# 2. 表结构会在后端启动时由 SQLAlchemy 自动创建，无需手动建表
# 3. 如果密码中包含 @ : / 等特殊字符，需要做 URL 编码
LLM_API_KEY=请替换为你的API密钥
LLM_BASE_URL=https://api.agnes-ai.cn/v1
LLM_MODEL=agnes-2.5-flash